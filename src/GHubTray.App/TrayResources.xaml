<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GHubTray.App"
    xmlns:tb="using:H.NotifyIcon">

    <local:TrayViewModel x:Key="TrayViewModel" />
    <XamlUICommand x:Key="RefreshCommand" Label="更新" />
    <XamlUICommand x:Key="SettingsCommand" Label="設定" />
    <XamlUICommand x:Key="ExitCommand" Label="終了" />

    <tb:TaskbarIcon
        x:Key="TrayIcon"
        ToolTipText="{Binding ToolTip, Source={StaticResource TrayViewModel}}"
        NoLeftClickDelay="True"
        PopupActivation="LeftClick"
        LeftClickCommand="{StaticResource RefreshCommand}"
        ContextMenuMode="SecondWindow">
        <tb:TaskbarIcon.IconSource>
            <tb:GeneratedIconSource
                Text="●"
                FontSize="42"
                Foreground="#FF60CDFF" />
        </tb:TaskbarIcon.IconSource>

        <tb:TaskbarIcon.TrayPopup>
            <Border
                Width="340"
                Padding="12"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel Spacing="8" DataContext="{StaticResource TrayViewModel}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="1">
                            <TextBlock Text="GHubTray" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdatedText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{StaticResource RefreshCommand}" ToolTipService.ToolTip="更新" AutomationProperties.Name="更新" Padding="8,4">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="10,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="{Binding TechnicalText}"
                                        AutomationProperties.Name="{Binding Name}">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                MaxLines="1" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{Binding PowerText}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Grid.RowSpan="2"
                                                Text="{Binding BatteryValue}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                MaxWidth="110"
                                                TextTrimming="CharacterEllipsis"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </tb:TaskbarIcon.TrayPopup>

        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Command="{StaticResource RefreshCommand}" Text="更新" Icon="Refresh" />
                <MenuFlyoutItem Command="{StaticResource SettingsCommand}" Text="設定" Icon="Setting" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{StaticResource ExitCommand}" Text="終了" />
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
