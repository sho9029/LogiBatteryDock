<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GHubTray.App"
    xmlns:tb="using:H.NotifyIcon">

    <local:TrayViewModel x:Key="TrayViewModel" />
    <XamlUICommand x:Key="RefreshCommand" Label="更新" />
    <XamlUICommand x:Key="SettingsCommand" Label="設定" />
    <XamlUICommand x:Key="ExitCommand" Label="終了" />

    <tb:TaskbarIcon
        x:Key="TrayIcon"
        ToolTipText="{Binding ToolTip, Source={StaticResource TrayViewModel}}"
        NoLeftClickDelay="True"
        PopupActivation="LeftClick"
        LeftClickCommand="{StaticResource RefreshCommand}"
        ContextMenuMode="SecondWindow">
        <tb:TaskbarIcon.IconSource>
            <tb:GeneratedIconSource
                Text="●"
                FontSize="42"
                Foreground="#FF60CDFF" />
        </tb:TaskbarIcon.IconSource>

        <tb:TaskbarIcon.TrayPopup>
            <Border
                Width="360"
                Padding="20"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="14" DataContext="{StaticResource TrayViewModel}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="GHubTray" FontSize="16" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Command="{StaticResource RefreshCommand}" ToolTipService.ToolTip="更新" AutomationProperties.Name="更新">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8"
                                        AutomationProperties.Name="{Binding Name}">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BatteryValue}" FontSize="25" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding PowerText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding TechnicalText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding UpdatedText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </tb:TaskbarIcon.TrayPopup>

        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Command="{StaticResource RefreshCommand}" Text="更新" Icon="Refresh" />
                <MenuFlyoutItem Command="{StaticResource SettingsCommand}" Text="設定" Icon="Setting" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{StaticResource ExitCommand}" Text="終了" />
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
